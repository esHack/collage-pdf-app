# Dropbox Configuration
#
# Preferred: the refresh-token flow. The SDK mints its own access tokens, so
# these credentials never expire.
#
# 1. https://www.dropbox.com/developers/apps -> your app -> Settings tab
#    Copy "App key" and "App secret" (click Show).
# 2. Permissions tab: check files.content.write, then Submit.
# 3. Open this URL in a browser, with your app key substituted in:
#    https://www.dropbox.com/oauth2/authorize?client_id=YOUR_APP_KEY&token_access_type=offline&response_type=code
#    Approve, then copy the authorization code it shows.
# 4. Trade the code for a refresh token (the code is single-use, expires in minutes):
#    curl -X POST https://api.dropboxapi.com/oauth2/token \
#      -u YOUR_APP_KEY:YOUR_APP_SECRET \
#      -d code=THE_CODE -d grant_type=authorization_code
#    Copy "refresh_token" out of the JSON response.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Legacy fallback. Used only when the three vars above are not all set.
# Tokens generated by the app console's "Generate access token" button start
# with "sl." and expire ~4 hours later — they will begin returning 401
# invalid_access_token. Use the refresh-token flow above instead.
# DROPBOX_ACCESS_TOKEN=

PORT=3001
